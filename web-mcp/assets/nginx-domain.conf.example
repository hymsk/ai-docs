# Example only. Prefer `web-mcp-manager.py nginx-template`, which renders this
# file from the live configuration. Review certificate paths before enabling.
#
# /docs/ serves the library's public/ directory rendered live at request time:
# no immutable caching and no /static/ alias, so edits and deletes take effect
# immediately. /assets/ forwards fingerprinted renderer assets (read-only
# manifest whitelist) so linked HTML can cache vendor scripts immutably.
# Public documents are indexable; /preview/, /mcp, /v1/ and /healthz/ stay
# closed unless explicitly exposed via --expose-preview / --expose-mcp (which
# require preview.login_mode="proxy" and add their own Basic Auth / rate-limit
# blocks).
limit_req_zone $binary_remote_addr zone=ai_docs_docs:10m rate=120r/m;
limit_req_status 429;

server {
    listen 443 ssl http2;
    server_name docs.example.com;

    ssl_certificate /path/to/fullchain.pem;
    ssl_certificate_key /path/to/privkey.pem;

    location ^~ /docs/ {
        limit_req zone=ai_docs_docs burst=40;
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        # 45s = backend public_docs.render_timeout_seconds (default 30s) + 15s
        # proxy headroom; the template follows the configured timeout.
        proxy_read_timeout 45s;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Renderer assets (/assets/<fingerprint>/<file>): manifest-whitelisted vendor
    # files only, served read-only by the backend with immutable caching.
    location ^~ /assets/ {
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }

    location = /preview { return 404; }
    location ^~ /preview/ { return 404; }
    location = /mcp { return 404; }
    location ^~ /v1/ { return 404; }
    location = /healthz { return 404; }
    location / { return 404; }
}
